# ==============================================================================
# Erosae.com — Production & Development Environment Configuration
# ==============================================================================

# 1. Database Connection URL
# On Hostinger MySQL: mysql://<username>:<password>@<host>:3306/<database_name>?sslmode=require
# Locally (Dev): file:./dev.db
DATABASE_URL="file:./dev.db"

# 2. Authentication Secret (Used for encrypting customer & admin JWT session tokens)
# Generate a random 32-character string before deploying to production.
NEXTAUTH_SECRET="your-random-32-char-secret-here"
NEXTAUTH_URL="https://erosae.com"

# 3. Public Domain / Hostname
NEXT_PUBLIC_APP_URL="https://erosae.com"

# 4. Optional External Gateway Secrets (Can also be managed directly inside the Admin Panel)
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."
BKASH_APP_KEY="..."
BKASH_APP_SECRET="..."
