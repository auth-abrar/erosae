# Environment Configuration for Erosae.com E-Commerce Platform

# ==============================================================================
# 1. DATABASE CONFIGURATION
# ==============================================================================
# LOCAL DEVELOPMENT (SQLite - zero setup required):
DATABASE_URL="file:./dev.db"

# HOSTINGER PRODUCTION (MySQL):
# Replace with your Hostinger MySQL database details from hPanel -> Databases -> MySQL Databases:
# DATABASE_URL="mysql://u123456789_erosae_user:YourStrongPassword@127.0.0.1:3306/u123456789_erosae_db"

# ==============================================================================
# 2. APPLICATION & AUTHENTICATION SECRETS
# ==============================================================================
# Used to sign session tokens and JWTs. Generate with openssl rand -base64 32
NEXTAUTH_SECRET="erosae-super-secret-jwt-key-change-in-production-2026-secure"
NEXTAUTH_URL="http://localhost:3000"

# 32-byte hexadecimal key to encrypt payment gateway secret keys at rest in the database
# Generate with openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ==============================================================================
# 3. PAYMENT GATEWAYS (Optional / Test mode defaults)
# ==============================================================================
# Stripe Keys (Obtain from https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample_erosae_key"
STRIPE_SECRET_KEY="sk_test_sample_erosae_secret"
STRIPE_WEBHOOK_SECRET="whsec_sample_erosae_webhook"

# ==============================================================================
# 4. STORE DEFAULTS
# ==============================================================================
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_DEFAULT_LANGUAGE="en"
NEXT_PUBLIC_STORE_NAME="Erosae"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
