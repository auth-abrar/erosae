// Prisma Schema for Erosae.com Multi-Category E-Commerce Platform
// Supports MySQL on Hostinger and SQLite locally for development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. IDENTITY, ACCESS & RBAC
// ==========================================

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  phone            String?   @unique
  passwordHash     String
  avatar           String?
  role             String    @default("CUSTOMER") // CUSTOMER, STAFF, ADMIN, SUPER_ADMIN
  status           String    @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  emailVerified    Boolean   @default(false)
  phoneVerified    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  wishlists         Wishlist[]
  cart              Cart?
  sessions          UserSession[]
  supportTickets    SupportTicket[]
  consentLogs       ConsentLog[]
  loyaltyAccount    LoyaltyAccount?
  giftCardsCreated  GiftCard[]       @relation("GiftCardSender")
  giftCardsReceived GiftCard[]       @relation("GiftCardRecipient")
  customerProfile   CustomerProfile?
}

model AdminUser {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  phone               String?
  passwordHash        String
  roleId              String
  role                Role      @relation(fields: [roleId], references: [id])
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  auditLogs       AuditLog[]
  sessions        UserSession[]
  assignedTickets SupportTicket[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // e.g. "Super Admin", "Order Manager", "Support Staff", "Finance Manager", "Warehouse Staff"
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  adminUsers  AdminUser[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. "products.view", "products.create", "orders.refund", "settings.security"
  name        String
  module      String // "catalog", "orders", "payments", "shipping", "crm", "erp", "settings"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserSession {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId  String?
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  sessionToken String     @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  isRevoked    Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String // e.g. "PRODUCT_CREATE", "PRICE_CHANGE", "ORDER_REFUND", "SETTING_UPDATE"
  resource    String // "Product", "Order", "PaymentGateway", "Role"
  resourceId  String?
  beforeState String? // JSON string
  afterState  String? // JSON string
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
}

// ==========================================
// 2. CATALOG, CATEGORIES, BRANDS & PRODUCTS
// ==========================================

model Category {
  id            String              @id @default(cuid())
  nameEn        String
  nameBn        String
  slug          String              @unique
  descriptionEn String?
  descriptionBn String?
  image         String?
  iconSvg       String?
  parentId      String?
  parent        Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[]          @relation("CategoryHierarchy")
  products      Product[]
  attributes    CategoryAttribute[]
  sortOrder     Int                 @default(0)
  isActive      Boolean             @default(true)
  metaTitleEn   String?
  metaTitleBn   String?
  metaDescEn    String?
  metaDescBn    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([slug])
  @@index([parentId])
}

model Brand {
  id            String    @id @default(cuid())
  nameEn        String
  nameBn        String
  slug          String    @unique
  logo          String?
  website       String?
  descriptionEn String?
  descriptionBn String?
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
}

model Attribute {
  id           String                  @id @default(cuid())
  nameEn       String // e.g. "Color", "Size", "RAM", "Storage"
  nameBn       String // e.g. "রঙ", "সাইজ", "র‌্যাম", "স্টোরেজ"
  code         String                  @unique // "color", "size", "ram"
  type         String                  @default("SELECT") // TEXT, NUMBER, SELECT, MULTISELECT, COLOR, BOOLEAN
  values       AttributeValue[]
  categories   CategoryAttribute[]
  productAttrs ProductAttributeValue[]
  createdAt    DateTime                @default(now())
}

model AttributeValue {
  id           String                  @id @default(cuid())
  attributeId  String
  attribute    Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  valueEn      String // "Red", "XL", "16GB"
  valueBn      String // "লাল", "এক্সএল", "১৬জিবি"
  colorHex     String? // e.g. "#FF0000"
  sortOrder    Int                     @default(0)
  productAttrs ProductAttributeValue[]
  createdAt    DateTime                @default(now())
}

model CategoryAttribute {
  categoryId   String
  attributeId  String
  isFilterable Boolean   @default(true)
  isRequired   Boolean   @default(false)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute    Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
}

model ProductAttributeValue {
  id               String         @id @default(cuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId      String
  attribute        Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
}

model Product {
  id            String  @id @default(cuid())
  type          String  @default("PHYSICAL") // PHYSICAL, DIGITAL, LICENSE_KEY, SERVICE, SUBSCRIPTION_SERVICE, BUNDLE, EXTERNAL
  titleEn       String
  titleBn       String
  slug          String  @unique
  descriptionEn String
  descriptionBn String
  shortDescEn   String?
  shortDescBn   String?

  // Financial & Pricing (BDT is Base)
  basePriceBDT    Float
  comparePriceBDT Float?
  costPriceBDT    Float?

  sku        String   @unique
  barcode    String?
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  isFeatured         Boolean @default(false)
  isPublished        Boolean @default(true)
  isBackorderAllowed Boolean @default(false)
  hasVariants        Boolean @default(false)

  weightGrams    Float?
  dimensionsJson String? // {"length": 10, "width": 5, "height": 2}

  ratingAverage Float @default(0.0)
  ratingCount   Int   @default(0)
  viewCount     Int   @default(0)

  metaTitleEn String?
  metaTitleBn String?
  metaDescEn  String?
  metaDescBn  String?

  variants        ProductVariant[]
  images          ProductImage[]
  customFields    ProductCustomField[]
  specifications  ProductSpecification[]
  faqs            ProductFAQ[]
  attributeValues ProductAttributeValue[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  inventoryItems  InventoryItem[]

  // Digital / License / Subscription links
  digitalAssets      DigitalAsset[]
  licenseKeyPools    LicenseKeyPool[]
  subscriptionConfig SubscriptionProductConfig?
  supplierProductMap SupplierProductMap?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  PurchaseOrderItem     PurchaseOrderItem[]
  InventorySerialNumber InventorySerialNumber[]
  InventoryBatch        InventoryBatch[]
  PickListItem          PickListItem[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([type])
  @@index([isPublished])
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String  @unique
  barcode         String?
  nameEn          String // e.g. "Red / XL"
  nameBn          String // e.g. "লাল / এক্সএল"
  priceBDT        Float
  comparePriceBDT Float?
  costPriceBDT    Float?
  stockQuantity   Int     @default(0)
  lowStockAlert   Int     @default(5)
  weightGrams     Float?
  attributesJson  String // {"color": "Red", "size": "XL"}
  image           String?
  isPublished     Boolean @default(true)

  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  PurchaseOrderItem     PurchaseOrderItem[]
  InventorySerialNumber InventorySerialNumber[]
  InventoryBatch        InventoryBatch[]
  PickListItem          PickListItem[]

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altEn     String?
  altBn     String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductCustomField {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fieldKey  String // e.g. "material", "battery"
  labelEn   String
  labelBn   String
  valueEn   String
  valueBn   String
  fieldType String   @default("text")
  createdAt DateTime @default(now())
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupEn   String   @default("General") // "Display", "Performance", "Battery"
  groupBn   String   @default("সাধারণ")
  keyEn     String
  keyBn     String
  valueEn   String
  valueBn   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductFAQ {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  questionEn String
  questionBn String
  answerEn   String
  answerBn   String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

// ==========================================
// 3. INVENTORY & WAREHOUSING
// ==========================================

model Warehouse {
  id                     String                   @id @default(cuid())
  name                   String
  code                   String                   @unique // "DHK-CENTRAL", "CTG-HUB"
  address                String
  city                   String
  isPrimary              Boolean                  @default(false)
  isActive               Boolean                  @default(true)
  inventoryItems         InventoryItem[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  GoodsReceipt           GoodsReceipt[]
  WarehouseLocation      WarehouseLocation[]
  CourierHandoverSession CourierHandoverSession[]
}

model InventoryItem {
  id          String          @id @default(cuid())
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantityOnHand    Int @default(0)
  quantityReserved  Int @default(0)
  quantityAvailable Int @default(0)
  quantityDamaged   Int @default(0)

  reorderPoint Int                    @default(10)
  transactions InventoryTransaction[]
  updatedAt    DateTime               @updatedAt

  @@unique([warehouseId, productId, variantId])
}

model InventoryTransaction {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            String // PURCHASE, SALE_RESERVE, SALE_FULFILL, RETURN, ADJUSTMENT, DAMAGE, TRANSFER
  quantityDelta   Int // e.g. +50, -1
  balanceAfter    Int
  referenceType   String? // "ORDER", "PURCHASE_ORDER", "MANUAL_ADJUSTMENT"
  referenceId     String?
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
  @@index([type])
  @@index([referenceType, referenceId])
}

// ==========================================
// 4. ORDERS, CHECKOUT & SNAPSHOTS
// ==========================================

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique // e.g. "ERO-2026-10001"
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])

  guestEmail String?
  guestPhone String?
  guestName  String?

  status            String @default("PENDING") // PENDING, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, COMPLETED, CANCELLED, REFUNDED, FAILED
  paymentStatus     String @default("PENDING") // PENDING, PAID, PARTIALLY_REFUNDED, REFUNDED, FAILED
  fulfillmentStatus String @default("UNFULFILLED") // UNFULFILLED, PARTIAL, FULFILLED, RETURNED

  paymentMethod String // "COD", "BKASH", "NAGAD", "SSLCOMMERZ", "STRIPE", "GIFT_CARD"

  currencyCode      String @default("BDT")
  exchangeRateToBDT Float  @default(1.0)

  subtotalAmountBDT Float
  taxAmountBDT      Float @default(0.0)
  shippingAmountBDT Float @default(0.0)
  discountAmountBDT Float @default(0.0)
  totalAmountBDT    Float

  paidAmountBDT Float @default(0.0)

  shippingAddressJson   String // Complete immutable JSON snapshot of address
  billingAddressJson    String?
  policyConsentSnapshot String? // Policy versions accepted at checkout

  customerNotes String?
  adminNotes    String?

  items          OrderItem[]
  payments       Payment[]
  shipments      Shipment[]
  timeline       OrderTimeline[]
  returnRequests ReturnRequest[]
  journalEntries JournalEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  // Historical Snapshots
  titleEn           String
  titleBn           String
  sku               String
  productType       String @default("PHYSICAL")
  unitPriceBDT      Float
  costPriceBDT      Float?
  quantity          Int
  totalPriceBDT     Float
  taxAmountBDT      Float  @default(0.0)
  discountAmountBDT Float  @default(0.0)

  customDetailsJson String? // Attribute snapshot, customizations

  // Associated Digital Grants & License Keys
  downloadGrants        DownloadGrant[]
  assignedLicenseKeys   LicenseKey[]
  returnItems           ReturnItem[]
  InventorySerialNumber InventorySerialNumber[]
  PickListItem          PickListItem[]

  @@index([orderId])
  @@index([productId])
}

model OrderTimeline {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  title       String
  description String?
  actorType   String   @default("SYSTEM") // SYSTEM, CUSTOMER, ADMIN, COURIER, GATEWAY
  actorId     String?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

// ==========================================
// 5. PAYMENTS & COURIER SETTLEMENTS
// ==========================================

model Payment {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gatewayCode         String // "BKASH", "NAGAD", "SSLCOMMERZ", "STRIPE", "COD"
  transactionRef      String?  @unique
  idempotencyKey      String?  @unique
  amount              Float
  currency            String   @default("BDT")
  status              String   @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  gatewayResponseJson String?
  paymentFeeAmount    Float    @default(0.0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([orderId])
  @@index([gatewayCode])
  @@index([status])
}

model PaymentGatewayConfig {
  id                  String   @id @default(cuid())
  code                String   @unique // "BKASH", "NAGAD", "SSLCOMMERZ", "STRIPE", "COD"
  nameEn              String
  nameBn              String
  isEnabled           Boolean  @default(false)
  isLiveMode          Boolean  @default(false)
  supportedCurrencies String // JSON array e.g. ["BDT", "USD"]
  credentialsEnc      String // Encrypted credentials JSON
  settingsJson        String? // Custom webhooks, instructions
  sortOrder           Int      @default(0)
  updatedAt           DateTime @updatedAt
}

model CourierSettlement {
  id             String    @id @default(cuid())
  courierCode    String // "PATHAO", "STEADFAST", "REDX"
  consignmentId  String
  orderNumber    String
  codAmount      Float
  courierFee     Float
  settledAmount  Float
  status         String    @default("PENDING") // PENDING, SETTLED, DISCREPANCY
  settlementDate DateTime?
  referenceNote  String?
  createdAt      DateTime  @default(now())
}

// ==========================================
// 6. SHIPPING & COURIERS
// ==========================================

model ShippingZone {
  id            String         @id @default(cuid())
  nameEn        String // "Inside Dhaka", "Outside Dhaka", "International"
  nameBn        String // "ঢাকার ভিতরে", "ঢাকার বাইরে", "আন্তর্জাতিক"
  code          String         @unique // "INSIDE_DHAKA", "OUTSIDE_DHAKA"
  countriesJson String // JSON array ["BD"]
  districtsJson String? // JSON array ["Dhaka"]
  rates         ShippingRate[]
  isActive      Boolean        @default(true)
}

model ShippingRate {
  id             String       @id @default(cuid())
  zoneId         String
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  titleEn        String
  titleBn        String
  rateBDT        Float
  freeAboveBDT   Float?
  minWeightGrams Float        @default(0)
  maxWeightGrams Float?
  estimatedDays  String? // "1-2 days", "৩-৫ দিন"
  isActive       Boolean      @default(true)
}

model CourierConfig {
  id             String   @id @default(cuid())
  code           String   @unique // "PATHAO", "STEADFAST", "DHL"
  name           String
  isEnabled      Boolean  @default(false)
  isLiveMode     Boolean  @default(false)
  credentialsEnc String // Encrypted API keys, Client ID, Secret
  settingsJson   String? // Webhook URLs, Store ID
  updatedAt      DateTime @updatedAt
}

model Shipment {
  id                  String                @id @default(cuid())
  orderId             String
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierCode         String // "PATHAO", "STEADFAST", "MANUAL"
  consignmentId       String?               @unique
  trackingCode        String?
  trackingUrl         String?
  labelUrl            String?
  status              String                @default("PENDING") // PENDING, PICKED_UP, IN_TRANSIT, DELIVERED, RETURNED, CANCELLED
  recipientPhone      String
  deliveryAddress     String
  codAmountBDT        Float                 @default(0.0)
  shippingCostBDT     Float                 @default(0.0)
  courierLogsJson     String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  packages            ShipmentPackage[]
  handoverItems       CourierHandoverItem[]

  @@index([orderId])
  @@index([consignmentId])
}

// ==========================================
// 7. RETURNS, RMA & REFUNDS
// ==========================================

model ReturnRequest {
  id             String           @id @default(cuid())
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id])
  userId         String?
  status         String           @default("REQUESTED") // REQUESTED, UNDER_REVIEW, APPROVED, REJECTED, PICKUP, RECEIVED, INSPECTING, REFUNDED, CLOSED
  reason         String // DAMAGED, WRONG_ITEM, DEFECTIVE, SIZE_FIT, CHANGED_MIND
  explanation    String?
  evidencePhotos String? // JSON array of image URLs
  refundMethod   String           @default("ORIGINAL_PAYMENT") // ORIGINAL_PAYMENT, STORE_CREDIT, BKASH_MANUAL
  refundAmount   Float            @default(0.0)
  adminNotes     String?
  items          ReturnItem[]
  timeline       ReturnTimeline[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  condition       String? // UNOPENED, OPENED_UNUSED, DAMAGED
}

model ReturnTimeline {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  status          String
  comment         String?
  actorId         String?
  createdAt       DateTime      @default(now())
}

// ==========================================
// 8. DIGITAL COMMERCE, LICENSES & SUBSCRIPTIONS
// ==========================================

model DigitalAsset {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName       String
  fileSize       Int
  mimeType       String
  storagePath    String // Secure private path on storage
  version        String?         @default("1.0")
  maxDownloads   Int             @default(5)
  expiresInDays  Int             @default(30)
  downloadGrants DownloadGrant[]
  createdAt      DateTime        @default(now())
}

model DownloadGrant {
  id             String       @id @default(cuid())
  orderItemId    String
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  digitalAssetId String
  digitalAsset   DigitalAsset @relation(fields: [digitalAssetId], references: [id])
  secureToken    String       @unique
  downloadCount  Int          @default(0)
  maxDownloads   Int          @default(5)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([secureToken])
}

model LicenseKeyPool {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  keys      LicenseKey[]
  createdAt DateTime     @default(now())
}

model LicenseKey {
  id           String         @id @default(cuid())
  poolId       String
  pool         LicenseKeyPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  keyEncrypted String // Encrypted license string
  status       String         @default("AVAILABLE") // AVAILABLE, ASSIGNED, USED, REVOKED
  orderItemId  String?
  orderItem    OrderItem?     @relation(fields: [orderItemId], references: [id])
  assignedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())

  @@index([status])
  @@index([orderItemId])
}

model SubscriptionProductConfig {
  id                    String   @id @default(cuid())
  productId             String   @unique
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  thirdPartyServiceName String // e.g. "ChatGPT Plus", "Canva Pro", "Office 365"
  durationMonths        Int      @default(1)
  activationGuideEn     String
  activationGuideBn     String
  disclosureNoticeEn    String
  disclosureNoticeBn    String
  autoFulfillSupported  Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

// ==========================================
// 9. DROPSHIPPING & SUPPLIER MANAGEMENT
// ==========================================

model Supplier {
  id              String               @id @default(cuid())
  name            String
  code            String               @unique // "CJ_DROP", "ALI_EXPRESS", "LOCAL_SUPPLIER_1"
  contactEmail    String?
  contactPhone    String?
  integrationType String               @default("MANUAL") // MANUAL, API_CJ, API_ALI, CSV
  apiEndpoint     String?
  credentialsEnc  String?
  leadTimeDays    Int                  @default(7)
  isActive        Boolean              @default(true)
  productMaps     SupplierProductMap[]
  supplierOrders  SupplierOrder[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  PurchaseOrder   PurchaseOrder[]
}

model SupplierProductMap {
  id               String    @id @default(cuid())
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId        String    @unique
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku      String
  supplierCostUSD  Float
  markupPercentage Float     @default(30.0)
  autoSyncStock    Boolean   @default(true)
  autoSyncPrice    Boolean   @default(false)
  lastSyncedAt     DateTime?
  syncErrorLog     String?
}

model SupplierOrder {
  id              String   @id @default(cuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  orderNumber     String
  supplierOrderId String?
  status          String   @default("PENDING") // PENDING, PLACED, SHIPPED, DELIVERED, CANCELLED
  totalCostUSD    Float
  trackingNumber  String?
  rawResponseJson String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// 10. POLICIES, COMPLIANCE & CONSENT
// ==========================================

model Policy {
  id        String          @id @default(cuid())
  type      String          @unique // TERMS, PRIVACY, RETURN_REFUND, SHIPPING, DIGITAL_TERMS, SUBSCRIPTION_TERMS, COOKIE_POLICY, WARRANTY
  slug      String          @unique // "terms-and-conditions", "privacy-policy", "refund-policy"
  titleEn   String
  titleBn   String
  versions  PolicyVersion[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model PolicyVersion {
  id            String       @id @default(cuid())
  policyId      String
  policy        Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  versionNumber Int // 1, 2, 3...
  contentEn     String // Full Markdown / HTML content
  contentBn     String
  status        String       @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  effectiveDate DateTime     @default(now())
  approvedBy    String?
  consentLogs   ConsentLog[]
  createdAt     DateTime     @default(now())

  @@unique([policyId, versionNumber])
}

model ConsentLog {
  id              String        @id @default(cuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  policyVersionId String
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id])
  consentContext  String // "CHECKOUT_ORDER_1001", "REGISTER_FORM", "COOKIE_BANNER"
  ipAddress       String?
  userAgent       String?
  consentedAt     DateTime      @default(now())

  @@index([userId])
  @@index([policyVersionId])
}

// ==========================================
// 11. ERP & DOUBLE-ENTRY ACCOUNTING
// ==========================================

model Account {
  id           String        @id @default(cuid())
  code         String        @unique // "1000" Cash, "1100" AR, "2000" AP, "4000" Revenue, "5000" COGS
  name         String // "Cash on Hand", "Accounts Receivable", "Sales Revenue"
  type         String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  currency     String        @default("BDT")
  balanceBDT   Float         @default(0.0)
  journalLines JournalLine[]
  createdAt    DateTime      @default(now())
}

model JournalEntry {
  id            String        @id @default(cuid())
  entryNumber   String        @unique // "JE-2026-0001"
  date          DateTime      @default(now())
  description   String
  referenceType String? // "ORDER", "REFUND", "EXPENSE", "PAYMENT_FEE"
  referenceId   String?
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  lines         JournalLine[]
  createdAt     DateTime      @default(now())

  @@index([entryNumber])
  @@index([referenceType, referenceId])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debitBDT       Float        @default(0.0)
  creditBDT      Float        @default(0.0)
  memo           String?

  @@index([journalEntryId])
  @@index([accountId])
}

// ==========================================
// 12. CRM, HELPDESK & SUPPORT
// ==========================================

model CustomerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalOrdersCount  Int       @default(0)
  totalSpentBDT     Float     @default(0.0)
  averageOrderValue Float     @default(0.0)
  tagsJson          String? // ["VIP", "Frequent Buyer", "High Risk"]
  internalNotes     String?
  segment           String    @default("NEW_CUSTOMER")
  lastOrderDate     DateTime?
  updatedAt         DateTime  @updatedAt
}

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique // "TCK-2026-001"
  userId       String?
  user         User?           @relation(fields: [userId], references: [id])
  guestEmail   String?
  guestName    String?
  subject      String
  category     String          @default("GENERAL") // ORDER, PAYMENT, RETURN, PRODUCT, TECHNICAL
  priority     String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status       String          @default("OPEN") // OPEN, IN_PROGRESS, WAITING_CUSTOMER, RESOLVED, CLOSED
  assignedToId String?
  assignedTo   AdminUser?      @relation(fields: [assignedToId], references: [id])
  messages     TicketMessage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([ticketNumber])
  @@index([status])
  @@index([userId])
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType  String // "CUSTOMER", "STAFF", "SYSTEM"
  senderId    String?
  message     String
  attachments String? // JSON array of URLs
  isInternal  Boolean       @default(false) // Staff internal note
  createdAt   DateTime      @default(now())

  @@index([ticketId])
}

// ==========================================
// 13. PROMOTIONS, COUPONS & LOYALTY
// ==========================================

model Coupon {
  id                String    @id @default(cuid())
  code              String    @unique
  descriptionEn     String?
  descriptionBn     String?
  discountType      String // "PERCENTAGE", "FIXED", "FREE_SHIPPING"
  discountValue     Float
  minSpendBDT       Float?
  maxDiscountBDT    Float?
  startDate         DateTime?
  endDate           DateTime?
  usageLimitTotal   Int?
  usageLimitPerUser Int?      @default(1)
  usageCount        Int       @default(0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
}

model LoyaltyAccount {
  id           String               @id @default(cuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsTotal  Int                  @default(0)
  transactions LoyaltyTransaction[]
  updatedAt    DateTime             @updatedAt
}

model LoyaltyTransaction {
  id               String         @id @default(cuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  pointsDelta      Int // e.g. +100 for order, -50 for discount
  type             String // "EARNED_ORDER", "REDEEMED", "REFERRAL_BONUS", "EXPIRED"
  referenceId      String?
  createdAt        DateTime       @default(now())
}

model GiftCard {
  id             String           @id @default(cuid())
  codeEncrypted  String           @unique
  initialValue   Float
  currentBalance Float
  senderId       String?
  sender         User?            @relation("GiftCardSender", fields: [senderId], references: [id])
  recipientId    String?
  recipient      User?            @relation("GiftCardRecipient", fields: [recipientId], references: [id])
  recipientEmail String?
  giftMessage    String?
  isActive       Boolean          @default(true)
  expiresAt      DateTime?
  ledger         GiftCardLedger[]
  createdAt      DateTime         @default(now())
}

model GiftCardLedger {
  id          String   @id @default(cuid())
  giftCardId  String
  giftCard    GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  amountDelta Float // -500 for redemption
  orderId     String?
  createdAt   DateTime @default(now())
}

// ==========================================
// 14. CURRENCIES & LOCALIZATION
// ==========================================

model Currency {
  id                String   @id @default(cuid())
  code              String   @unique // BDT, USD, EUR, GBP, AED, SAR, QAR, OMR, KWD, BHD, INR
  nameEn            String
  nameBn            String
  symbol            String
  symbolPosition    String   @default("BEFORE") // "BEFORE" (৳100) or "AFTER"
  decimalPlaces     Int      @default(2)
  exchangeRateToBDT Float    @default(1.0) // How many BDT = 1 Unit of this currency
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

// ==========================================
// 15. REVIEWS, CART, WISHLIST & ADDRESSES
// ==========================================

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  rating     Int // 1 to 5
  title      String?
  comment    String
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model Address {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String
  addressLine1      String
  addressLine2      String?
  city              String
  district          String?
  postalCode        String?
  countryCode       String   @default("BD")
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())

  @@index([cartId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([wishlistId])
}

// ==========================================
// 16. CMS, SETTINGS & EMAIL TEMPLATES
// ==========================================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON string
  group     String   @default("general") // general, branding, localization, payments, shipping, security
  updatedAt DateTime @updatedAt
}

model Banner {
  id         String   @id @default(cuid())
  titleEn    String
  titleBn    String
  subtitleEn String?
  subtitleBn String?
  imageUrl   String
  linkUrl    String?
  badgeEn    String?
  badgeBn    String?
  position   String   @default("HERO") // HERO, SIDEBAR, FOOTER_PROMO, POPUP
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique // "about-us", "faq", "contact-us"
  titleEn     String
  titleBn     String
  contentEn   String
  contentBn   String
  isPublished Boolean  @default(true)
  metaTitleEn String?
  metaTitleBn String?
  metaDescEn  String?
  metaDescBn  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(cuid())
  code      String   @unique // "ORDER_CONFIRMATION", "SHIPPING_NOTICE", "PASSWORD_RESET", "WELCOME"
  name      String
  subjectEn String
  subjectBn String
  bodyEn    String // Safe template with {{variable}} placeholders
  bodyBn    String
  variables String // JSON array of available variables e.g. ["orderNumber", "customerName", "total"]
  updatedAt DateTime @updatedAt
}

model Translation {
  id           String   @id @default(cuid())
  key          String
  namespace    String   @default("general")
  valueEn      String
  valueBn      String
  isCustomized Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([key, namespace])
  @@index([namespace])
}

// ==========================================
// 17. PURCHASING, POs & GOODS RECEIVING
// ==========================================

model PurchaseOrder {
  id            String              @id @default(cuid())
  poNumber      String              @unique // e.g. "PO-2026-001"
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  status        String              @default("DRAFT") // DRAFT, ISSUED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  totalCostBDT  Float               @default(0.0)
  expectedDate  DateTime?
  notes         String?
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String          @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  quantityOrdered  Int
  quantityReceived Int             @default(0)
  unitCostBDT      Float
  totalCostBDT     Float
  createdAt        DateTime        @default(now())

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique // e.g. "GR-2026-001"
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  receivedById    String?
  notes           String?
  receivedAt      DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([warehouseId])
}

// ==========================================
// 18. TAX ENGINE & JURISDICTION CLASSES
// ==========================================

model TaxClass {
  id          String   @id @default(cuid())
  code        String   @unique // "STANDARD_VAT", "REDUCED", "ZERO_RATED", "EXEMPT"
  nameEn      String
  nameBn      String
  ratePercent Float    @default(0.0) // e.g. 5.0, 7.5, 15.0
  isInclusive Boolean  @default(false)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 19. INTEGRATION WEBHOOK IDEMPOTENCY LOGS
// ==========================================

model WebhookEvent {
  id           String    @id @default(cuid())
  provider     String // "BKASH", "NAGAD", "SSLCOMMERZ", "STRIPE", "PATHAO", "STEADFAST", "CJ"
  eventId      String    @unique
  eventType    String
  payloadJson  String
  isProcessed  Boolean   @default(false)
  processedAt  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([provider, eventId])
  @@index([isProcessed])
}

// ==========================================
// 20. WAREHOUSE LOCATIONS & BINS
// ==========================================

model WarehouseLocation {
  id          String                  @id @default(cuid())
  warehouseId String
  warehouse   Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone        String // e.g. "ZONE-A", "MEZZANINE"
  aisle       String // e.g. "A01"
  rack        String // e.g. "R04"
  shelf       String // e.g. "S02"
  bin         String // e.g. "B07"
  barcode     String                  @unique // e.g. "LOC-DHK-A01-R04-S02-B07"
  isActive    Boolean                 @default(true)
  serialItems InventorySerialNumber[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([warehouseId])
}

// ==========================================
// 21. SERIALIZED & BATCH INVENTORY
// ==========================================

model InventorySerialNumber {
  id                  String             @id @default(cuid())
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant?    @relation(fields: [variantId], references: [id])
  serialNumber        String             @unique // IMEI, Device Serial, Activation Code
  status              String             @default("RECEIVED") // RECEIVED, STORED, RESERVED, PICKED, SOLD, DELIVERED, RETURNED, DAMAGED
  warehouseLocationId String?
  warehouseLocation   WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])
  orderItemId         String?
  orderItem           OrderItem?         @relation(fields: [orderItemId], references: [id])
  purchaseOrderId     String?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([productId])
  @@index([serialNumber])
  @@index([status])
}

model InventoryBatch {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  batchNumber    String // e.g. "BAT-2026-08A"
  mfgDate        DateTime?
  expiryDate     DateTime?
  quantityOnHand Int             @default(0)
  costPriceBDT   Float           @default(0.0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([productId])
  @@index([batchNumber])
  @@index([expiryDate])
}

// ==========================================
// 22. PICK LISTS & PACKING WORKFLOW
// ==========================================

model PickList {
  id              String         @id @default(cuid())
  pickNumber      String         @unique // e.g. "PICK-2026-0001"
  type            String         @default("SINGLE_ORDER") // SINGLE_ORDER, BATCH_PICK, WAREHOUSE_ZONE
  status          String         @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  assignedStaffId String?
  notes           String?
  items           PickListItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}

model PickListItem {
  id              String          @id @default(cuid())
  pickListId      String
  pickList        PickList        @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem       @relation(fields: [orderItemId], references: [id])
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  quantityOrdered Int
  quantityPicked  Int             @default(0)
  isVerified      Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@index([pickListId])
  @@index([orderItemId])
}

model ShipmentPackage {
  id             String   @id @default(cuid())
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  packageNumber  String // e.g. "PKG-1", "PKG-2"
  weightGrams    Float    @default(0.0)
  dimensionsJson String? // {"length": 20, "width": 15, "height": 10}
  barcode        String   @unique // Package Scan Barcode
  trackingCode   String?
  createdAt      DateTime @default(now())

  @@index([shipmentId])
}

// ==========================================
// 23. COURIER HANDOVER SESSIONS & MANIFESTS
// ==========================================

model CourierHandoverSession {
  id            String                @id @default(cuid())
  sessionNumber String                @unique // e.g. "HND-2026-001"
  courierCode   String // "STEADFAST", "PATHAO", "REDX"
  warehouseId   String
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  status        String                @default("OPEN") // OPEN, CONFIRMED, RECONCILED
  totalParcels  Int                   @default(0)
  totalCodBDT   Float                 @default(0.0)
  staffId       String?
  confirmedAt   DateTime?
  notes         String?
  items         CourierHandoverItem[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([courierCode])
  @@index([status])
}

model CourierHandoverItem {
  id           String                 @id @default(cuid())
  sessionId    String
  session      CourierHandoverSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  shipmentId   String
  shipment     Shipment               @relation(fields: [shipmentId], references: [id])
  trackingCode String
  codAmountBDT Float                  @default(0.0)
  scannedAt    DateTime               @default(now())

  @@index([sessionId])
  @@index([trackingCode])
}

// ==========================================
// 24. COD SETTLEMENT RECONCILIATION
// ==========================================

model CourierSettlementReconciliation {
  id                  String    @id @default(cuid())
  reconciliationNum   String    @unique // e.g. "REC-2026-001"
  courierCode         String
  statementRef        String
  totalExpectedCod    Float     @default(0.0)
  totalSettledCod     Float     @default(0.0)
  courierFeesDeducted Float     @default(0.0)
  discrepancyAmount   Float     @default(0.0)
  status              String    @default("PENDING") // PENDING, MATCHED, DISCREPANCY, SETTLED
  notes               String?
  settledDate         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([courierCode])
  @@index([status])
}
